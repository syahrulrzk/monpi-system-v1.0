[
  {
    "id": "1",
    "name": "User Service",
    "url": "/api/users",
    "auth": {
      "required": false
    }
  },
  {
    "id": "2",
    "name": "Auth Service",
    "url": "/api/auth",
    "auth": {
      "required": false
    }
  },
  {
    "id": "3",
    "name": "Payment Service",
    "url": "/api/payments",
    "auth": {
      "required": true,
      "type": "bearer",
      "token": "${PAYMENT_API_TOKEN}"
    }
  },
  {
    "id": "4",
    "name": "Notification Service",
    "url": "/api/notifications",
    "auth": {
      "required": false
    }
  },
  {
    "id": "5",
    "name": "Analytics Service",
    "url": "/api/analytics",
    "auth": {
      "required": true,
      "type": "api-key",
      "key": "${ANALYTICS_API_KEY}",
      "header": "x-api-key"
    }
  },
  {
    "id": "6",
    "name": "Test Service",
    "url": "/api/test",
    "auth": {
      "required": true,
      "type": "api-key",
      "key": "${ANALYTICS_API_KEY}",
      "header": "x-api-key"
    }
  }
]