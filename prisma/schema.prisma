// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemStatus {
  id              String   @id @default(cuid())
  systemHealth    Float    @default(100.0)
  totalRequests   Int      @default(0)
  errorRate       Float    @default(0.0)
  avgResponseTime Int      @default(0)
  serverStatus    String   @default("Online")
  serverLatency   Int      @default(0)
  timestamp       DateTime @default(now())
  
  @@map("system_status")
}

model ApiEndpoint {
  id           String   @id @default(cuid())
  name         String
  url          String
  status       String   @default("healthy")
  lastCheck    DateTime @default(now())
  responseTime Int      @default(0)
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("api_endpoints")
}

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   @default("INFO")
  message   String
  source    String
  createdAt DateTime @default(now())
  
  @@map("system_logs")
}

model PerformanceMetric {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  requests     Int      @default(0)
  responseTime Int      @default(0)
  endpointId   String?
  
  @@map("performance_metrics")
}

model RequestData {
  id              String   @id @default(cuid())
  endpointId      String   @unique
  totalRequests   Int      @default(0)
  hourlyRequests  Json     @default("[]") // Array of 24 numbers
  lastReset       DateTime @default(now())
  lastCheck       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("request_data")
}

model TimeRangeData {
  id        String   @id @default(cuid())
  endpointId String   @unique
  oneDay    Int      @default(0) @map("1d")
  threeDays Int      @default(0) @map("3d")
  sevenDays Int      @default(0) @map("7d")
  fourteenDays Int   @default(0) @map("14d")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("time_range_data")
}